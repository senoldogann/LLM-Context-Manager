# CCM Environment Configuration
# Copy this file to .env and update values as needed

# ============================================
# EMBEDDING PROVIDER
# ============================================
# Options: "ollama" (local) or "openai" (cloud)
EMBEDDING_PROVIDER=ollama

# ============================================
# OLLAMA CONFIGURATION (Local AI)
# ============================================
# Start Ollama with: ollama serve
# Pull model with: ollama pull mxbai-embed-large
EMBEDDING_HOST=http://127.0.0.1:11434
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_API_KEY=ollama

# ============================================
# OPENAI CONFIGURATION (Cloud AI)
# ============================================
# Uncomment and fill in for OpenAI usage:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_HOST=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-your-api-key-here

# ============================================
# NETWORKING & LIMITS
# ============================================
# Embedding request timeout in seconds
EMBEDDING_TIMEOUT_SECS=30

# Max file size (bytes) to index as text
CCM_MAX_FILE_BYTES=2097152

# Optional: disable embeddings entirely (semantic search disabled)
CCM_DISABLE_EMBEDDER=0

# Optional: embed data files (md/json/yaml) into vector search
CCM_EMBED_DATA_FILES=0

# ============================================
# MCP SECURITY & RUNTIME
# ============================================
# Allowlist for MCP project roots (semicolon or colon separated)
# Example: CCM_ALLOWED_ROOTS=/Users/you/projects:/Users/you/sandbox
# CCM_ALLOWED_ROOTS=

# Require allowlist to be set (reject all project paths if empty)
CCM_REQUIRE_ALLOWED_ROOTS=0

# MCP engine cache size (number of project engines kept in memory)
CCM_MCP_ENGINE_CACHE_SIZE=8

# MCP JSON-RPC debug logging (1/true/yes enables)
CCM_MCP_DEBUG=0

# ============================================
# BINARY SECURITY
# ============================================
# Enforce checksum validation for npm wrapper (0 = enforce, 1 = bypass)
CCM_ALLOW_UNVERIFIED_BINARIES=0

# ============================================
# LOGGING
# ============================================
# Options: error, warn, info, debug, trace
RUST_LOG=info
