# CCM Environment Configuration
# Copy this file to ~/.ccm/.env. CCM never loads a project's own .env: an
# untrusted repository could otherwise redirect embedding requests.

# ============================================
# EMBEDDING PROVIDER
# ============================================
# Options: "local" (built-in, default), "ollama" (local service) or "openai"
# (and other OpenAI-compatible services).
# Leave EMBEDDING_PROVIDER, EMBEDDING_HOST and EMBEDDING_MODEL unset to use the
# built-in local model. If only EMBEDDING_HOST or EMBEDDING_MODEL is set, the
# previous Ollama/OpenAI resolution applies (existing configs keep working).
# EMBEDDING_PROVIDER=local
#
# Optional upgrade: an OPENAI_API_KEY in this file (~/.ccm/.env) switches to
# OpenAI text-embedding-3-small on the official https://api.openai.com/v1
# endpoint, without a separate CCM_ALLOW_REMOTE_EMBEDDING opt-in. Code chunks
# are then sent to OpenAI. A key that is only exported in your shell never
# switches the provider.
# OPENAI_API_KEY=sk-your-api-key-here

# ============================================
# BUILT-IN LOCAL MODEL (default)
# ============================================
# ibm-granite/granite-embedding-97m-multilingual-r2 (Apache-2.0, int8 ONNX,
# 384-d) runs inside the binary via ONNX Runtime. The first use downloads
# ~124 MB from Hugging Face at a pinned revision and verifies every file's
# SHA-256; nothing about your code is sent. Pre-fetch: `ccm-cli models pull`.
# Not available on Intel macOS (x86_64-apple-darwin): there CCM builds a
# graph-only index until OPENAI_API_KEY is added here or EMBEDDING_PROVIDER is set.
# Root directory for model files (default: ~/.ccm/models)
# CCM_MODEL_DIR=/absolute/path/to/models
# ONNX Runtime threads (default: physical cores, capped by the CPU quota)
# CCM_EMBED_THREADS=4
# Hugging Face mirror used for the one-time download (checksums still apply)
# HF_ENDPOINT=https://huggingface.co

# ============================================
# OLLAMA CONFIGURATION (Local service)
# ============================================
# Start Ollama with: ollama serve
# Pull model with: ollama pull mxbai-embed-large
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_HOST=http://127.0.0.1:11434
# EMBEDDING_MODEL=mxbai-embed-large
# EMBEDDING_API_KEY=ollama

# ============================================
# OPENAI CONFIGURATION (Cloud AI)
# ============================================
# The OPENAI_API_KEY line above is enough; EMBEDDING_MODEL alone picks another
# OpenAI embedding model. Explicit overrides (EMBEDDING_API_KEY is an alias for
# OPENAI_API_KEY):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_HOST=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-your-api-key-here

# Changing the provider or model re-embeds the index once on the next
# `ccm-cli index` / `index_project`; vectors of different models are never mixed.

# ============================================
# NETWORKING & LIMITS
# ============================================
# Remote embedding (Ollama/OpenAI) request timeout in seconds
# Alias also accepted: CCM_EMBEDDING_TIMEOUT_SECS
EMBEDDING_TIMEOUT_SECS=30

# Max file size (bytes) to index as text
CCM_MAX_FILE_BYTES=2097152

# Optional: disable embeddings entirely (semantic search disabled)
# Alias also accepted: EMBEDDING_DISABLED
CCM_DISABLE_EMBEDDER=0

# Optional: embed data files (md/json/yaml) into vector search
# Alias also accepted: CCM_EMBED_DATA
CCM_EMBED_DATA_FILES=0

# Optional: truncate node content before sending it to Ollama
# (the local model truncates each input to 512 tokens)
CCM_MAX_EMBED_CHARS=6000

# Chunking for large texts before vector storage
CCM_MAX_CHUNK_CHARS=1000
CCM_CHUNK_OVERLAP=100

# Texts per Ollama/OpenAI request (default: 32).
# CCM_EMBED_BATCH_SIZE=32
# Texts per built-in model inference (default: 1). Larger batches make a
# chunk's vector depend on its batch-mates because int8 activations are
# quantized per inference call.
# CCM_LOCAL_EMBED_BATCH=1

# Embedding eşzamanlılığı: Ollama tek model işçisiyle istekleri kuyruğa alır;
# bu yüzden varsayılan 1'dir. OLLAMA_NUM_PARALLEL>1 gibi gerçek paralel
# çalıştıran sağlayıcılar için 2-8 arası değer verilebilir.
CCM_EMBED_CONCURRENCY=1

# Güvenlik: embedding istekleri onaysız yalnızca loopback hedeflere ve resmi
# OpenAI HTTPS endpoint'ine gönderilir. Azure, TEI, Voyage gibi başka bir dış
# OpenAI-uyumlu sağlayıcı kullanıyorsanız bu onayı açıkça verin.
# CCM_ALLOW_REMOTE_EMBEDDING=1

# Minimum hybrid score retained by hybrid search
CCM_MIN_COMBINED_SCORE=0.05

# Hybrid ranking weights (normalized to sum to 1.0)
CCM_HYBRID_GRAPH_WEIGHT=0.55
CCM_HYBRID_SEM_WEIGHT=0.35
CCM_HYBRID_SPATIAL_WEIGHT=0.08
CCM_HYBRID_RECENT_WEIGHT=0.02

# Maximum index issues recorded per pass
CCM_MAX_INDEX_ISSUES=250

# ============================================
# MCP SECURITY & RUNTIME
# ============================================
# Optional: pin the default project root; overrides the workspace the host reports
# via MCP roots. Without it: host roots -> launch dir inside CCM_ALLOWED_ROOTS ->
# the single CCM_ALLOWED_ROOTS entry. If CCM_ALLOWED_ROOTS is empty, this root is
# also treated as an implicit allowed root.
# CCM_PROJECT_ROOT=/absolute/path/to/project

# Optional: override the default MCP vector DB path
# CCM_DB_PATH=/absolute/path/to/data/ccm_db

# Allowlist for MCP project roots (semicolon or colon separated)
# Example: CCM_ALLOWED_ROOTS=/Users/you/projects:/Users/you/sandbox
# CCM_ALLOWED_ROOTS=

# Require allowlist to be set (reject all project paths if empty).
# STRICT IS THE DEFAULT: unset or 1 enforces the allowlist.
# Set 0 only to relax; even then access stays within the startup project root.
# Alias also accepted: CCM_MCP_REQUIRE_ALLOWED_ROOTS
CCM_REQUIRE_ALLOWED_ROOTS=1

# MCP engine cache size (number of project engines kept in memory)
CCM_MCP_ENGINE_CACHE_SIZE=8

# Arka plan indeks worker hard deadline degeri saniye cinsindendir (varsayilan 7200, ust sinir 86400)
CCM_INDEX_EXECUTION_TIMEOUT_SECS=7200

# Eşzamanlı embedding batch sayısı (1-8). Varsayılan 1: Ollama tek işçiyle
# istekleri kuyruğa alır, eşzamanlılık hızlandırmaz ve timeout riski ekler.
# Yalnız OLLAMA_NUM_PARALLEL>1 ortamlarında yükseltin.
CCM_EMBED_CONCURRENCY=1

# MCP JSON-RPC debug logging (1/true/yes enables)
CCM_MCP_DEBUG=0

# ============================================
# BINARY SECURITY
# ============================================
# Enforce checksum validation for npm wrapper (0 = enforce, 1 = bypass)
# Alias also accepted: CCM_SKIP_CHECKSUM
CCM_ALLOW_UNVERIFIED_BINARIES=0

# ============================================
# LOGGING
# ============================================
# Options: error, warn, info, debug, trace
RUST_LOG=info
